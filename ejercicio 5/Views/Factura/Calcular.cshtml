ViewData["Title"]="Factura";

<h2>Factura</h2>
<form asp-action="Calcular" method="post">
    @Html.AntiForgeryToken()
    <label>Monto RD$:</label>
    <input type="number" step="any" name="monto" required />
    <select name="opcion">
        <option value="ITBIS">Aplicar ITBIS (18%)</option>
        <option value="Descuento">Aplicar Descuento (15%)</option>
    </select>
    <button type="submit">Calcular</button>
</form>

@if(ViewBag.Total != null)
{
    <p>Subtotal: @ViewBag.Subtotal</p>
    @if(ViewBag.Impuesto>0) { <p>ITBIS: @ViewBag.Impuesto</p> }
    @if(ViewBag.Descuento>0) { <p>Descuento: @ViewBag.Descuento</p> }
    <p><strong>Total: @ViewBag.Total</strong></p>
}
